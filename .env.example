# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the session pooler URI on port 5432, not the transaction pooler, because
# pgvector queries want a real session.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Embeddings only. Cheap: the whole corpus costs a few cents to embed.
OPENAI_API_KEY=sk-...

# Generation and grading.
ANTHROPIC_API_KEY=sk-ant-...

# Guards POST /api/documents. Leave unset and HTTP ingestion is disabled,
# which is the right default for a public URL. Any long random string works.
INGEST_TOKEN=
