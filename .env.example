# The only value the deployed app actually needs.
# Generation and grading run on Groq through its OpenAI-compatible endpoint.
GROQ_API_KEY=gsk_...

# Optional overrides. Defaults are llama-3.3-70b-versatile and https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Writes only, and LOCAL ONLY. Never set this on the deployment: the public app
# is read-only by design and has no write endpoint. You need this to run
# `python -m rolefit.ingest`.
# Supabase -> Project Settings -> API Keys -> secret key
SUPABASE_SECRET_KEY=

# These two have sensible defaults baked into rolefit/config.py and are
# publishable on purpose. A Supabase publishable key is designed to ship in
# browser bundles; it grants nothing because every table has RLS on with no
# policies, and all reads go through security-definer functions.
# SUPABASE_URL=https://usfxjkroohbttyntpymd.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Embeddings need no key at all. They run on gte-small inside a Supabase Edge
# Function, because Groq exposes no embeddings endpoint.
